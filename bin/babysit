#!/usr/bin/env bash
set -euo pipefail

VERSION="0.6.0"
SCRIPT_STARTED="$(date +%s)"

usage() {
  cat <<'EOF'
Usage:
  babysit [options] [pr-number|pr-url] [extra context...]

Runs the review-fix cycle for an existing GitHub PR until pr-codex-review
reports zero Blockers and Critical findings and CI is green:

  1. Run pr-codex-review in the background (it posts its review comment to
     the PR) while waiting for CI. Red checks go to a Codex fix session that
     fixes and pushes (up to --max-ci-fixes attempts); the review of the
     outgoing head is then discarded and rerun.
  2. Zero Blockers and Critical -> done, notification.
     Otherwise -> Codex checks each finding (real issue or intended?),
     fixes the real ones, commits, and pushes. The pipeline posts a PR
     comment logging what was fixed and goes back to 1 (up to --max-iter
     rounds). Waiting for CI is the pipeline's job, never Codex's.

Without a PR argument the PR of the current branch is used. Any extra
positional text is handed to the Codex fix session as additional context.

The Codex fix sessions run with --dangerously-bypass-approvals-and-sandbox
by default: they must run tests, use gh, and push, all unattended.
Pass --sandboxed to use your codex sandbox/approval defaults instead.

The PR's implementation must be committed and pushed before starting: the
pipeline works on the pushed PR head in its own worktree and never touches
your checkout.

The run is fully autonomous by default: you can start it and walk away.
Product questions go back to Codex to decide itself (conservatively,
documented in the PR comment), a dispute of remaining findings is accepted
only after one forced adversarial re-check, and changed .envrc files are
allowed automatically. Pass --interactive to be asked at these gates in
the terminal instead; interactive gates need a terminal on stdin and
abort with exit 2 without one.

Options:
  --model MODEL            Model for the Codex fix sessions.
                           Default: your codex default
  --effort LEVEL           Reasoning effort for the Codex fix sessions:
                           minimal, low, medium, high, xhigh
  --reviewers N            Reviewer passes per pr-codex-review round.
                           Default: pr-codex-review default
  --review-model MODEL     Model for pr-codex-review. Default: codex default
  --review-effort LEVEL    Effort for pr-codex-review. Default: codex default
  --max-iter N             Max review->fix rounds. Default: 12
  --max-ci-fixes N         Max CI fix attempts per green-CI phase. Default: 3
  --fix-timeout DURATION   Kill a Codex fix step that runs longer than this.
                           A fix step includes waiting for CI, so keep this
                           above your CI runtime. Seconds or 30m/2h;
                           0 disables. Default: 2h
  --sandboxed              Run Codex fix sessions with your codex
                           sandbox/approval defaults instead of
                           --dangerously-bypass-approvals-and-sandbox
  --interactive            Stop at gates (open questions, disputes, .envrc
                           changes) and ask in the terminal instead of
                           deciding autonomously
  --verbose                Stream the full Codex and review output to the
                           terminal instead of the quiet status line
  --no-notify              Disable macOS notifications
  --no-direnv              Skip direnv allow/exec
  --keep-worktree          Keep the temporary worktree after success
  --version                Show version
  -h, --help               Show this help

Exit codes:
  0  success: CI green and review clean, or remaining findings
     disputed by Codex and accepted (by you, or automatically
     after the forced re-check in autonomous mode)
  2  aborted at a gate: user abort or missing terminal with
     --interactive, or Codex keeps asking questions although
     autonomous mode told it to decide itself
  3  CI still red after --max-ci-fixes attempts
  4  review not converged after --max-iter rounds
  5  a fix round produced no changes although findings remain

Examples:
  babysit                  # PR of the current branch
  babysit 1811
  babysit 1811 --effort high "Focus on the time-tracking module"
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

PR_ARG=""
CONTEXT_INPUT=""
MODEL=""
EFFORT=""
REVIEWERS=""
REVIEW_MODEL=""
REVIEW_EFFORT=""
MAX_ITER=12
MAX_CI_FIXES=3
FIX_TIMEOUT="2h"
BYPASS=1
VERBOSE=0
INTERACTIVE=0
NOTIFY=1
USE_DIRENV=1
CLEANUP=1

while [ "$#" -gt 0 ]; do
  case "$1" in
    --model)          MODEL="${2:-}"; shift 2 ;;
    --model=*)        MODEL="${1#*=}"; shift ;;
    --effort)         EFFORT="${2:-}"; shift 2 ;;
    --effort=*)       EFFORT="${1#*=}"; shift ;;
    --reviewers)      REVIEWERS="${2:-}"; shift 2 ;;
    --reviewers=*)    REVIEWERS="${1#*=}"; shift ;;
    --review-model)   REVIEW_MODEL="${2:-}"; shift 2 ;;
    --review-model=*) REVIEW_MODEL="${1#*=}"; shift ;;
    --review-effort)  REVIEW_EFFORT="${2:-}"; shift 2 ;;
    --review-effort=*) REVIEW_EFFORT="${1#*=}"; shift ;;
    --max-iter)       MAX_ITER="${2:-}"; shift 2 ;;
    --max-iter=*)     MAX_ITER="${1#*=}"; shift ;;
    --max-ci-fixes)   MAX_CI_FIXES="${2:-}"; shift 2 ;;
    --max-ci-fixes=*) MAX_CI_FIXES="${1#*=}"; shift ;;
    --fix-timeout)    FIX_TIMEOUT="${2:-}"; shift 2 ;;
    --fix-timeout=*)  FIX_TIMEOUT="${1#*=}"; shift ;;
    --sandboxed)      BYPASS=0; shift ;;
    --interactive)    INTERACTIVE=1; shift ;;
    --verbose)        VERBOSE=1; shift ;;
    --no-notify)      NOTIFY=0; shift ;;
    --no-direnv)      USE_DIRENV=0; shift ;;
    --keep-worktree)  CLEANUP=0; shift ;;
    --version)        echo "babysit $VERSION"; exit 0 ;;
    -h|--help)        usage; exit 0 ;;
    -*)               die "unknown option: $1" ;;
    *)
      if [ -z "$PR_ARG" ] && { [[ "$1" =~ ^[0-9]+$ ]] || [[ "$1" =~ ^https://github\.com/[^/]+/[^/]+/pull/[0-9]+ ]]; }; then
        PR_ARG="$1"
      elif [ -n "$CONTEXT_INPUT" ]; then
        CONTEXT_INPUT="$CONTEXT_INPUT $1"
      else
        CONTEXT_INPUT="$1"
      fi
      shift
      ;;
  esac
done

[[ "$MAX_ITER" =~ ^[0-9]+$ ]] || die "--max-iter must be a number"
[[ "$MAX_CI_FIXES" =~ ^[0-9]+$ ]] || die "--max-ci-fixes must be a number"
[ "$MAX_ITER" -ge 1 ] || die "--max-iter must be >= 1"
[ -z "$REVIEWERS" ] || [[ "$REVIEWERS" =~ ^[0-9]+$ ]] || die "--reviewers must be a number"
# Codex silently ignores an unknown effort value instead of failing.
case "$EFFORT" in
  ""|minimal|low|medium|high|xhigh) ;;
  *) die "--effort must be one of: minimal, low, medium, high, xhigh" ;;
esac
case "$REVIEW_EFFORT" in
  ""|minimal|low|medium|high|xhigh) ;;
  *) die "--review-effort must be one of: minimal, low, medium, high, xhigh" ;;
esac

duration_to_seconds() {
  local value="$1"
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    echo "$value"
  elif [[ "$value" =~ ^([0-9]+)s$ ]]; then
    echo "${BASH_REMATCH[1]}"
  elif [[ "$value" =~ ^([0-9]+)m$ ]]; then
    echo "$((BASH_REMATCH[1] * 60))"
  elif [[ "$value" =~ ^([0-9]+)h$ ]]; then
    echo "$((BASH_REMATCH[1] * 3600))"
  else
    die "--fix-timeout must be seconds or a duration like 30m, 45m, 1h, or 0"
  fi
}

FIX_TIMEOUT_SECONDS="$(duration_to_seconds "$FIX_TIMEOUT")"

CODEX_FLAGS=()
[ -z "$MODEL" ] || CODEX_FLAGS+=(-m "$MODEL")
[ -z "$EFFORT" ] || CODEX_FLAGS+=(-c "model_reasoning_effort=$EFFORT")
# Fix sessions push and watch CI via gh, unattended; a sandboxed or
# approval-gated codex exec would silently skip those commands.
[ "$BYPASS" -eq 0 ] || CODEX_FLAGS+=(--dangerously-bypass-approvals-and-sandbox)

need gh
need git
need jq
need codex
need pr-codex-review
if [ "$USE_DIRENV" -eq 1 ]; then
  need direnv
fi

C_GREEN=""
C_RED=""
C_DIM=""
C_BOLD=""
C_RESET=""
UI_TTY=0
if [ -t 1 ] && [ -n "${TERM:-}" ] && command -v tput >/dev/null 2>&1; then
  UI_TTY=1
  C_GREEN="$(tput setaf 2 2>/dev/null || true)"
  C_RED="$(tput setaf 1 2>/dev/null || true)"
  C_DIM="$(tput dim 2>/dev/null || true)"
  C_BOLD="$(tput bold 2>/dev/null || true)"
  C_RESET="$(tput sgr0 2>/dev/null || true)"
fi

SPIN_FRAMES=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
SYM_OK="ok:"
HR_LINE="------------------------------------------------------------"
if [ "$UI_TTY" -eq 1 ]; then
  SYM_OK="✓"
  HR_LINE="────────────────────────────────────────────────────────────"
fi

# One transient status line at the bottom of the output, redrawn in place.
# Only used on a TTY; everything permanent goes through plain echo.
STATUS_SHOWN=0
draw_status() {
  if [ "$UI_TTY" -eq 1 ]; then
    printf '\r\033[K%s' "${C_DIM}$1${C_RESET}"
    STATUS_SHOWN=1
  fi
}

clear_status() {
  if [ "$STATUS_SHOWN" -eq 1 ]; then
    printf '\r\033[K'
    STATUS_SHOWN=0
  fi
}

hr() {
  echo "${C_DIM}${HR_LINE}${C_RESET}"
}

row() {
  printf '  %-10s %s\n' "$1" "$2"
}

step() {
  echo
  echo "${C_BOLD}==> $*${C_RESET}"
}

notify() {
  printf '\a'
  [ "$NOTIFY" -eq 1 ] || return 0
  osascript \
    -e 'on run argv' \
    -e 'display notification (item 2 of argv) with title "babysit" subtitle (item 1 of argv) sound name "Glass"' \
    -e 'end run' \
    "$1" "$2" >/dev/null 2>&1 || true
}

format_duration() {
  local total="$1"
  printf '%dm%02ds' "$((total / 60))" "$((total % 60))"
}

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run from inside the target git repository"
CURRENT_REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
SAFE_REPO="${CURRENT_REPO//\//-}"

# --- Resolve the PR -----------------------------------------------------------

if [[ "$PR_ARG" =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
  [ "${BASH_REMATCH[1]}" = "$CURRENT_REPO" ] || die "PR URL is for ${BASH_REMATCH[1]}, but current checkout is $CURRENT_REPO"
  PR_ARG="${BASH_REMATCH[2]}"
fi

if [ -n "$PR_ARG" ]; then
  PR_META="$(gh pr view "$PR_ARG" --json number,title,body,url,state,headRefName,baseRefName,headRefOid,isCrossRepository)"
else
  PR_META="$(gh pr view --json number,title,body,url,state,headRefName,baseRefName,headRefOid,isCrossRepository 2>/dev/null)" \
    || die "no PR found for the current branch; pass a PR number"
fi
PR_STATE="$(jq -r '.state' <<<"$PR_META")"
[ "$PR_STATE" = "OPEN" ] || die "PR is $PR_STATE, expected an open PR"
PR_NUMBER="$(jq -r '.number' <<<"$PR_META")"
PR_TITLE="$(jq -r '.title' <<<"$PR_META")"
PR_URL="$(jq -r '.url' <<<"$PR_META")"
BRANCH="$(jq -r '.headRefName' <<<"$PR_META")"
BASE_BRANCH="$(jq -r '.baseRefName' <<<"$PR_META")"
HEAD_SHA_META="$(jq -r '.headRefOid' <<<"$PR_META")"
# The pipeline fetches and pushes refs/heads/<branch> on origin; for a fork
# PR that branch lives in the fork, and a same-named origin branch would be
# reviewed and pushed instead.
[ "$(jq -r '.isCrossRepository' <<<"$PR_META")" != "true" ] \
  || die "PR #$PR_NUMBER is a cross-repository (fork) PR; the pipeline can only work on branches in $CURRENT_REPO"

PR_CONTEXT="PR #$PR_NUMBER: $PR_TITLE
Branch: $BRANCH (base: $BASE_BRANCH)
URL: $PR_URL

PR description:

$(jq -r '.body' <<<"$PR_META")"
if [ -n "$CONTEXT_INPUT" ]; then
  PR_CONTEXT="$PR_CONTEXT

Additional context from the user:

$CONTEXT_INPUT"
fi

# --- Run directory and worktree ------------------------------------------------

RUN_ID="$(date +%Y%m%d-%H%M%S)"
RUN_ROOT="$HOME/.cache/babysit/$SAFE_REPO-pr-$PR_NUMBER-$RUN_ID"
WORKTREE="$RUN_ROOT/worktree"
LOG_DIR="$RUN_ROOT/logs"
MSG_DIR="$RUN_ROOT/messages"
mkdir -p "$LOG_DIR" "$MSG_DIR"

while IFS= read -r old_dir; do
  [ "$old_dir" = "$RUN_ROOT" ] && continue
  git -C "$REPO_ROOT" worktree remove "$old_dir/worktree" --force >/dev/null 2>&1 || true
  rm -rf "$old_dir"
done < <(find "$HOME/.cache/babysit" -mindepth 1 -maxdepth 1 -type d -mtime +7 2>/dev/null)
git -C "$REPO_ROOT" worktree prune >/dev/null 2>&1 || true

MODEL_DESC="codex default"
if [ -n "$MODEL" ] && [ -n "$EFFORT" ]; then
  MODEL_DESC="$MODEL (effort $EFFORT)"
elif [ -n "$MODEL" ]; then
  MODEL_DESC="$MODEL"
elif [ -n "$EFFORT" ]; then
  MODEL_DESC="codex default (effort $EFFORT)"
fi

echo "${C_BOLD}babysit v$VERSION${C_RESET}"
hr
row "PR" "${C_BOLD}#$PR_NUMBER $PR_TITLE${C_RESET}"
row "Repo" "$CURRENT_REPO"
row "Branch" "$BRANCH -> $BASE_BRANCH"
row "Model" "$MODEL_DESC"
if [ "$BYPASS" -eq 1 ]; then
  row "Sandbox" "bypassed (--dangerously-bypass-approvals-and-sandbox)"
else
  row "Sandbox" "codex defaults (--sandboxed)"
fi
if [ "$INTERACTIVE" -eq 1 ]; then
  row "Mode" "interactive (gates ask in the terminal)"
else
  row "Mode" "autonomous"
fi
row "Loops" "max $MAX_ITER review rounds, $MAX_CI_FIXES CI fixes"
row "Timeout" "$FIX_TIMEOUT per codex fix step"
row "Run dir" "$RUN_ROOT"
hr

cd "$REPO_ROOT"

# The pipeline reviews the pushed PR head. Local work that only exists in the
# user's checkout would silently be ignored, so refuse to start in that case.
if [ "$(git rev-parse --abbrev-ref HEAD)" = "$BRANCH" ] && [ -n "$(git status --porcelain)" ]; then
  die "your checkout of $BRANCH has uncommitted changes; commit and push them first so the pipeline sees them"
fi

git fetch -q origin "+refs/heads/$BRANCH:refs/remotes/origin/$BRANCH"
HEAD_SHA="$(git rev-parse "origin/$BRANCH")"
if [ "$HEAD_SHA" != "$HEAD_SHA_META" ]; then
  echo "warning: origin/$BRANCH ($HEAD_SHA) differs from GitHub metadata ($HEAD_SHA_META); using origin/$BRANCH" >&2
fi
if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  LOCAL_SHA="$(git rev-parse "refs/heads/$BRANCH")"
  [ "$LOCAL_SHA" = "$HEAD_SHA" ] || die "local branch $BRANCH ($LOCAL_SHA) differs from origin ($HEAD_SHA); push your local commits first"
fi

git worktree add --quiet --detach "$WORKTREE" "$HEAD_SHA"
echo "Worktree: $WORKTREE (PR head $HEAD_SHA)"

# Set while a background pr-codex-review runs (see start_review).
REVIEW_PID=""

# shellcheck disable=SC2329,SC2317  # invoked via the EXIT trap below
cleanup() {
  local rc=$?
  # A backgrounded review would otherwise outlive the pipeline.
  [ -z "$REVIEW_PID" ] || kill_tree "$REVIEW_PID" 2>/dev/null || true
  if [ "$rc" -eq 0 ] && [ "$CLEANUP" -eq 1 ] && [ -d "$WORKTREE" ]; then
    git -C "$REPO_ROOT" worktree remove "$WORKTREE" --force >/dev/null 2>&1 || true
  elif [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
    # Exit 2 is a user-initiated gate abort; no notification needed for that.
    notify "Abbruch" "Pipeline gestoppt (exit $rc). Details: $RUN_ROOT"
  fi
}
trap cleanup EXIT

# --- direnv ---------------------------------------------------------------------

DIRENV_ACTIVE=0
ENVRC_STAMP=""
ENVRC_BASELINE_FILE="$RUN_ROOT/envrc-baseline"

envrc_stamp() {
  (
    cd "$WORKTREE"
    find . -name .envrc -not -path './.git/*' -print 2>/dev/null \
      | while IFS= read -r path; do
          repo_path="${path#./}"
          if grep -Fqx "$path" "$ENVRC_BASELINE_FILE" \
            || ! git check-ignore -q -- "$repo_path"; then
            shasum "$path"
          fi
        done \
      | sort
  )
}

if [ "$USE_DIRENV" -eq 1 ] && find "$WORKTREE" -name .envrc -not -path "$WORKTREE/.git/*" -print -quit | grep -q .; then
  (cd "$WORKTREE" && find . -name .envrc -not -path './.git/*' -print 2>/dev/null | sort) \
    > "$ENVRC_BASELINE_FILE"
  (cd "$WORKTREE" && direnv allow)
  DIRENV_ACTIVE=1
  ENVRC_STAMP="$(envrc_stamp)"
  echo "direnv:   allowed"
fi

# The PR-head .envrc files were allowed above. Keep watching those files and
# new non-ignored .envrc files, but skip files generated later in ignored
# caches such as .devbox; direnv never approved or loads those cache files.
check_envrc() {
  [ "$DIRENV_ACTIVE" -eq 1 ] || return 0
  local now reply
  now="$(envrc_stamp)"
  [ "$now" = "$ENVRC_STAMP" ] && return 0
  echo "${C_RED}A .envrc file changed inside the worktree.${C_RESET}" >&2
  git -C "$WORKTREE" diff "$HEAD_SHA" -- .envrc ':(glob)**/.envrc' >&2 || true
  if [ "$INTERACTIVE" -eq 0 ]; then
    # With the sandbox bypassed Codex can already execute anything, so
    # auto-allowing its .envrc edit is no additional exposure; warn and go on.
    echo "${C_DIM}autonomous mode: running direnv allow on the changed .envrc${C_RESET}" >&2
    notify "direnv" ".envrc geaendert, automatisch freigegeben"
    (cd "$WORKTREE" && direnv allow)
    ENVRC_STAMP="$(envrc_stamp)"
    return 0
  fi
  notify "direnv" ".envrc wurde veraendert, Freigabe noetig"
  require_tty "the .envrc approval gate"
  printf 'Run direnv allow for the changed .envrc? [y/N] '
  read -r reply
  if [ "$reply" = "y" ] || [ "$reply" = "Y" ]; then
    (cd "$WORKTREE" && direnv allow)
    ENVRC_STAMP="$(envrc_stamp)"
  else
    echo "Refusing to continue with an unapproved .envrc change." >&2
    exit 2
  fi
}

# shellcheck disable=SC2329,SC2317  # invoked indirectly via run_with_timeout "$@"
run_in_worktree() {
  if [ "$DIRENV_ACTIVE" -eq 1 ]; then
    (cd "$WORKTREE" && direnv exec "$WORKTREE" "$@")
  else
    (cd "$WORKTREE" && "$@")
  fi
}

# --- Timeouts -----------------------------------------------------------------------

child_pids() {
  local pid="$1"
  ps -axo pid=,ppid= | awk -v p="$pid" '$2 == p { print $1 }'
}

kill_tree() {
  local pid="$1"
  local children child
  children="$(child_pids "$pid" || true)"
  for child in $children; do
    kill_tree "$child"
  done
  kill -TERM "$pid" 2>/dev/null || true
}

force_kill_tree() {
  local pid="$1"
  local children child
  children="$(child_pids "$pid" || true)"
  for child in $children; do
    force_kill_tree "$child"
  done
  kill -KILL "$pid" 2>/dev/null || true
}

# In quiet mode (default) the poll loop also ticks the transient status
# line, so the label set in STEP_LABEL is what the user sees while a Codex
# step runs. Verbose mode streams Codex output instead, so no status line.
STEP_LABEL=""

run_with_timeout() {
  local seconds="$1"
  local label="$2"
  local log_file="$3"
  shift 3

  if [ -n "$log_file" ]; then
    "$@" >"$log_file" 2>&1 &
  else
    "$@" &
  fi
  local child="$!"
  local started elapsed tick=0
  started="$(date +%s)"
  while kill -0 "$child" 2>/dev/null; do
    elapsed="$(( $(date +%s) - started ))"
    if [ "$seconds" -gt 0 ] && [ "$elapsed" -ge "$seconds" ]; then
      clear_status
      echo "error: codex step timed out after $label; terminating process tree rooted at $child" >&2
      kill_tree "$child"
      sleep 2
      if kill -0 "$child" 2>/dev/null; then
        force_kill_tree "$child"
      fi
      wait "$child" 2>/dev/null || true
      return 124
    fi
    if [ "$VERBOSE" -eq 0 ]; then
      draw_status "${SPIN_FRAMES[$((tick % ${#SPIN_FRAMES[@]}))]} $STEP_LABEL · $(format_duration "$elapsed")"
    fi
    tick=$((tick + 1))
    sleep 1
  done
  clear_status
  wait "$child"
}

# --- Codex session plumbing -------------------------------------------------------

SESSION_ID=""
LAST_MSG=""

# Codex records every session as a rollout file whose first line contains the
# session cwd. The worktree path is unique per run, so matching on it finds
# exactly our session even when other Codex sessions run in parallel.
capture_session_id() {
  local dir f
  for dir in "$HOME/.codex/sessions/$(date +%Y/%m/%d)" \
             "$HOME/.codex/sessions/$(date -v-1d +%Y/%m/%d 2>/dev/null || true)"; do
    [ -d "$dir" ] || continue
    while IFS= read -r f; do
      if head -n 1 "$f" 2>/dev/null | grep -Fq "\"cwd\":\"$WORKTREE\""; then
        SESSION_ID="$(basename "$f" | sed -nE 's/^rollout-.*-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$/\1/p')"
        [ -n "$SESSION_ID" ] && return 0
      fi
    done < <(ls -t "$dir"/rollout-*.jsonl 2>/dev/null)
  done
  return 1
}

# Runs a codex exec step: quiet by default (full output goes to the log,
# the terminal gets the status line and a completion line), streamed with
# --verbose. Returns codex's exit code, or 124 on timeout.
run_codex_step() {
  local tag="$1"
  shift
  local rc started
  case "$tag" in
    fix-round-*) STEP_LABEL="Fix round ${tag#fix-round-}" ;;
    ci-fix-*)    STEP_LABEL="CI fix ${tag#ci-fix-}" ;;
    *)           STEP_LABEL="Codex $tag" ;;
  esac
  started="$(date +%s)"
  set +e
  if [ "$VERBOSE" -eq 1 ]; then
    run_with_timeout "$FIX_TIMEOUT_SECONDS" "$FIX_TIMEOUT" "" "$@" </dev/null 2>&1 | tee "$LOG_DIR/$tag.log"
    rc="${PIPESTATUS[0]}"
  else
    if [ "$UI_TTY" -eq 0 ]; then
      echo "running: $STEP_LABEL"
    fi
    run_with_timeout "$FIX_TIMEOUT_SECONDS" "$FIX_TIMEOUT" "$LOG_DIR/$tag.log" "$@" </dev/null
    rc=$?
  fi
  set -e
  if [ "$rc" -eq 0 ]; then
    echo "${C_DIM}$SYM_OK $STEP_LABEL · $(format_duration "$(( $(date +%s) - started ))")${C_RESET}"
  fi
  return "$rc"
}

codex_new() {
  local tag="$1" prompt="$2" rc=0
  LAST_MSG="$MSG_DIR/$tag.md"
  check_envrc
  run_codex_step "$tag" \
    run_in_worktree codex exec ${CODEX_FLAGS[@]+"${CODEX_FLAGS[@]}"} \
    -o "$LAST_MSG" "$prompt" || rc=$?
  [ "$rc" -ne 124 ] || die "codex fix step timed out after $FIX_TIMEOUT (--fix-timeout; 0 disables), see $LOG_DIR/$tag.log"
  [ "$rc" -eq 0 ] || die "codex exec failed with exit $rc, see $LOG_DIR/$tag.log"
  [ -s "$LAST_MSG" ] || die "codex produced no final message, see $LOG_DIR/$tag.log"
  capture_session_id || die "could not find the Codex session for $WORKTREE under ~/.codex/sessions"
}

codex_resume() {
  local tag="$1" prompt="$2" rc=0
  [ -n "$SESSION_ID" ] || die "no Codex session to resume"
  LAST_MSG="$MSG_DIR/$tag.md"
  check_envrc
  run_codex_step "$tag" \
    run_in_worktree codex exec resume "$SESSION_ID" ${CODEX_FLAGS[@]+"${CODEX_FLAGS[@]}"} \
    -o "$LAST_MSG" "$prompt" || rc=$?
  [ "$rc" -ne 124 ] || die "codex fix step timed out after $FIX_TIMEOUT (--fix-timeout; 0 disables), see $LOG_DIR/$tag.log"
  [ "$rc" -eq 0 ] || die "codex exec resume failed with exit $rc, see $LOG_DIR/$tag.log"
  [ -s "$LAST_MSG" ] || die "codex produced no final message, see $LOG_DIR/$tag.log"
}

# In interactive mode Codex may stop and ask; in autonomous mode it must
# decide itself (the OPEN QUESTIONS marker stays available as a last resort,
# but question_gate then bounces it straight back).
if [ "$INTERACTIVE" -eq 1 ]; then
  DECISION_RULE="- Only for product decisions you cannot responsibly make yourself (data semantics, user-visible policy, migration of existing data): stop and end your final message with a line that is exactly:
OPEN QUESTIONS:
followed by short numbered questions. Use this marker for nothing else. You will receive the user's answers and can then continue."
else
  DECISION_RULE="- No human is available during this run. Make every decision yourself, including product decisions: pick the most conservative reasonable option and record notable decisions in the PR comment section of your final message. Do not stop to ask questions."
fi

RULES="You are the fix agent for an existing pull request, running unattended inside an automated pipeline (CI checks -> external code review -> fix rounds), in a dedicated git worktree on a detached checkout of the PR head.

Standing rules for every step:
- Follow this repository's contributor and agent instructions (AGENTS.md, CLAUDE.md, CONTRIBUTING) where present.
- Keep changes minimal and focused on the findings you are asked to address; match the existing code style and do not refactor beyond that.
- Write clean, descriptive commit messages. Never mention AI, agents, Codex, or automation anywhere.
- You are on a detached checkout, so push with exactly: git push origin HEAD:refs/heads/$BRANCH
- Only push when a step explicitly tells you to. Never create or edit PRs or comments, never rewrite published history.
- Make reasonable technical decisions yourself.
$DECISION_RULE
- If an external review finding rated Blocker or Critical is factually wrong and no code change is warranted, do not change code just to satisfy the review. Instead end your final message with a line that is exactly:
DISPUTED FINDINGS:
followed by short numbered rebuttals, one per disputed finding, each naming the finding and why it is wrong. Use this marker only for Blocker/Critical findings you are confident are incorrect, never to avoid work, and never together with code changes that already resolve the finding."

# First call carries the standing rules and PR context; later calls resume the
# same session, so context carries through all CI and review fix rounds.
codex_call() {
  local tag="$1" prompt="$2"
  if [ -z "$SESSION_ID" ]; then
    codex_new "$tag" "$RULES

## Pull request

$PR_CONTEXT

## Current step

$prompt"
  else
    codex_resume "$tag" "$prompt"
  fi
}

# --- Gates ------------------------------------------------------------------------

# Gates read answers from the terminal. Without one, stdin hits EOF and the
# gate would spin or die without explanation, so abort clearly instead.
# cleanup() suppresses the failure notification for exit 2, hence the
# explicit notify here.
require_tty() {
  [ -t 0 ] && return 0
  notify "Gate" "Interaktive Eingabe noetig, aber kein Terminal"
  echo "error: $* requires interactive input but stdin is not a terminal; rerun in an interactive terminal" >&2
  exit 2
}

# Codex ends its final message with an "OPEN QUESTIONS:" line when it needs a
# product decision. Surface the questions, collect answers, resume the session.
question_gate() {
  local tag_base="$1" n=0 answers line
  while grep -q '^OPEN QUESTIONS:' "$LAST_MSG"; do
    n=$((n + 1))
    echo
    hr
    sed -n '/^OPEN QUESTIONS:/,$p' "$LAST_MSG"
    hr
    if [ "$INTERACTIVE" -eq 0 ]; then
      # Codex was told not to ask; bounce the questions back a few times,
      # then give up rather than looping forever.
      if [ "$n" -gt 3 ]; then
        notify "Festgefahren" "Codex stellt weiter Fragen im autonomen Modus"
        echo "Codex keeps asking questions although autonomous mode told it to decide itself; a human is needed: $PR_URL" >&2
        exit 2
      fi
      echo "${C_DIM}autonomous mode: sending the questions back for Codex to decide itself${C_RESET}"
      codex_resume "$tag_base-answers-$n" "No human is available during this automated run. Decide these questions yourself: pick the most conservative reasonable option for each, apply it, and record the decision in the PR comment section of your final message. Continue with the current step. All rules from the initial instructions still apply."
      continue
    fi
    notify "Offene Fragen" "Codex braucht eine Entscheidung von dir"
    require_tty "the open-questions gate"
    echo "Answer the questions. Finish with an empty line; 'q' aborts the pipeline."
    answers=""
    while IFS= read -r line; do
      if [ "$line" = "q" ]; then
        echo "Aborted at the question gate." >&2
        exit 2
      fi
      [ -n "$line" ] || break
      answers="$answers$line
"
    done
    if [ -z "$answers" ]; then
      echo "No answer given; the questions are shown again."
      continue
    fi
    codex_resume "$tag_base-answers-$n" "Answers from the user to your open questions:

$answers
Continue with the current step using these decisions. All rules from the initial instructions still apply."
  done
}

# Codex ends a fix round with "DISPUTED FINDINGS:" when it believes the
# remaining Blocker/Critical findings are wrong and no code change is
# warranted. Only reached when the round produced no commits. Interactive
# mode: a human accepts, replies, or aborts. Autonomous mode: the dispute
# is never accepted as-is; Codex must survive one forced adversarial
# re-check first, then the rebuttals are accepted and shown in the summary.
# Either way a round without commits and without a live dispute still
# stops the run (exit 5).
DISPUTE_ACCEPTED=0
DISPUTE_TEXT=""

dispute_gate() {
  local tag_base="$1" pre_sha="$2" n=0 reply line
  while :; do
    n=$((n + 1))
    echo
    hr
    sed -n '/^DISPUTED FINDINGS:/,$p' "$LAST_MSG"
    hr
    if [ "$INTERACTIVE" -eq 0 ]; then
      if [ "$n" -ge 2 ]; then
        DISPUTE_ACCEPTED=1
        DISPUTE_TEXT="$(sed -n '/^DISPUTED FINDINGS:/,$p' "$LAST_MSG")"
        echo "${C_DIM}autonomous mode: dispute upheld after the forced re-check, accepting the rebuttals${C_RESET}"
        return 0
      fi
      echo "${C_DIM}autonomous mode: forcing one adversarial re-check of the dispute${C_RESET}"
      codex_resume "$tag_base-dispute-$n" "Re-examine your disputed findings adversarially, as if a colleague insisted they are real. For each one, actively try to construct the failure scenario the reviewer describes and check the code against it. If a finding turns out to be real after all, implement the fix and commit. Only if you remain confident it is wrong after this re-check, explain why and end your message with the DISPUTED FINDINGS: marker again. All rules from the initial instructions still apply."
    else
      notify "Disputed findings" "Codex haelt verbleibende Findings fuer falsch"
      require_tty "the dispute gate"
      echo "Codex disputes the remaining Blocker/Critical findings instead of changing code."
      echo "Type 'a' to accept the rebuttals and finish the run, 'q' to abort,"
      echo "or type a reply to Codex (finish with an empty line)."
      reply=""
      while IFS= read -r line; do
        if [ -z "$reply" ] && [ "$line" = "a" ]; then
          DISPUTE_ACCEPTED=1
          DISPUTE_TEXT="$(sed -n '/^DISPUTED FINDINGS:/,$p' "$LAST_MSG")"
          return 0
        fi
        if [ -z "$reply" ] && [ "$line" = "q" ]; then
          echo "Aborted at the dispute gate." >&2
          exit 2
        fi
        [ -n "$line" ] || break
        reply="$reply$line
"
      done
      if [ -z "$reply" ]; then
        echo "No input given; the disputed findings are shown again."
        continue
      fi
      codex_resume "$tag_base-dispute-$n" "The user does not accept your dispute as-is and replies:

$reply
Reconsider the disputed findings with this input. If the user is right, implement the fix and commit. If you still believe a finding is wrong, explain why and end your message with the DISPUTED FINDINGS: marker again. All rules from the initial instructions still apply."
    fi
    question_gate "$tag_base-dispute-$n"
    ensure_committed "$tag_base-dispute-$n"
    if [ "$(git -C "$WORKTREE" rev-parse HEAD)" != "$pre_sha" ]; then
      return 0
    fi
    if ! grep -q '^DISPUTED FINDINGS:' "$LAST_MSG"; then
      notify "Festgefahren" "Dispute-Runde ohne Commits und ohne Dispute"
      echo "Codex neither fixed nor still disputes the remaining findings; a human is needed: $PR_URL" >&2
      trap - EXIT
      exit 5
    fi
  done
}

ensure_committed() {
  local tag="$1"
  if [ -n "$(git -C "$WORKTREE" status --porcelain)" ]; then
    codex_call "$tag-commit" "There are uncommitted changes in the worktree. Review them and commit everything that belongs to the task (git add + git commit with a descriptive message). Do not push."
    question_gate "$tag-commit"
  fi
  [ -z "$(git -C "$WORKTREE" status --porcelain)" ] || die "worktree still has uncommitted changes; inspect $WORKTREE"
}

# Codex pushes during its step; this is the safety net for a forgotten push
# (pushing an already-pushed head is a no-op). After a push, gh pr checks can
# briefly still report the previous head's completed checks, so a red new
# commit could read green. Wait until GitHub reports the pushed sha as the
# PR head.
push_branch() {
  local pushed_sha remote_sha waited=0
  pushed_sha="$(git -C "$WORKTREE" rev-parse HEAD)"
  git -C "$WORKTREE" push -q origin "HEAD:refs/heads/$BRANCH"
  while :; do
    remote_sha="$(gh pr view "$PR_NUMBER" --json headRefOid -q .headRefOid 2>/dev/null || true)"
    [ "$remote_sha" = "$pushed_sha" ] && return 0
    [ "$waited" -lt 180 ] || die "GitHub still reports PR head $remote_sha instead of the pushed $pushed_sha after ${waited}s; is someone else pushing to $BRANCH?"
    echo "${C_DIM}waiting for GitHub to register the pushed head...${C_RESET}"
    sleep 5
    waited=$((waited + 5))
  done
}

ROUND_LOG=""
CI_FIX_TOTAL=0

record_round() {
  local label="$1" pre="$2" commits
  commits="$(git -C "$WORKTREE" log --oneline "$pre..HEAD" 2>/dev/null || true)"
  [ -n "$commits" ] || return 0
  ROUND_LOG="$ROUND_LOG$label:
$commits

"
  printf '%s:\n%s\n\n' "$label" "$commits" >> "$LOG_DIR/rounds.log"
}

# Post the per-round fix log to the PR. The comment text comes from the
# PR COMMENT: section of the round's final Codex message; if a later gate
# step produced the newest message, the round's base message still has it.
# Fallback: the round's commit list.
post_fix_comment() {
  local round="$1" pre_sha="$2" body="" commits f
  for f in "$LAST_MSG" "$MSG_DIR/fix-round-$round.md"; do
    [ -f "$f" ] || continue
    if grep -q '^PR COMMENT:' "$f"; then
      body="$(sed -n '/^PR COMMENT:/,$p' "$f" | sed '1d')"
      break
    fi
  done
  if [ -z "$body" ]; then
    commits="$(git -C "$WORKTREE" log --oneline "$pre_sha..HEAD" 2>/dev/null || true)"
    [ -n "$commits" ] || return 0
    # shellcheck disable=SC2016  # the backticks are literal markdown fences
    body="$(printf 'Review round %s:\n\n```\n%s\n```' "$round" "$commits")"
  fi
  gh pr comment "$PR_NUMBER" --body "$body" >/dev/null \
    || echo "warning: could not post the fix-log comment to PR #$PR_NUMBER" >&2
}

# --- Review -----------------------------------------------------------------------

REVIEW_ARGS=()
[ -z "$REVIEWERS" ] || REVIEW_ARGS+=(-n "$REVIEWERS")
[ -z "$REVIEW_MODEL" ] || REVIEW_ARGS+=(--model "$REVIEW_MODEL")
[ -z "$REVIEW_EFFORT" ] || REVIEW_ARGS+=(--effort "$REVIEW_EFFORT")

list_review_runs() {
  find "$HOME/.cache/pr-codex-review" -mindepth 1 -maxdepth 1 -type d \
    -name "$SAFE_REPO-pr-$PR_NUMBER-*" 2>/dev/null | sort
}

# A review needs the pushed PR head, not green CI, so it runs in the background
# while ensure_ci_green watches the checks. It must never overlap a Codex
# session: a CI fix moves the head sha out from under the findings, which is
# why ensure_ci_green calls discard_review before starting one.
REVIEW_ROUND=0
REVIEW_STARTED=0
RUNS_BEFORE=""

start_review() {
  REVIEW_ROUND="$1"
  RUNS_BEFORE="$(list_review_runs)"
  REVIEW_STARTED="$(date +%s)"
  # pr-codex-review prints its own banner and the full review comment, which
  # duplicates what babysit already shows; keep all of it in the log.
  pr-codex-review "$PR_NUMBER" ${REVIEW_ARGS[@]+"${REVIEW_ARGS[@]}"} \
    >"$LOG_DIR/review-$REVIEW_ROUND.log" 2>&1 </dev/null &
  REVIEW_PID="$!"
}

# Waits for an already-running background process while ticking the status
# line. run_with_timeout cannot be used here because it starts the process
# itself; the review is started a step earlier so it can overlap the CI wait.
wait_with_status() {
  local pid="$1" started="$2" rc=0 tick=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$VERBOSE" -eq 0 ]; then
      draw_status "${SPIN_FRAMES[$((tick % ${#SPIN_FRAMES[@]}))]} $STEP_LABEL · $(format_duration "$(( $(date +%s) - started ))")"
    fi
    tick=$((tick + 1))
    sleep 1
  done
  clear_status
  set +e
  wait "$pid"
  rc=$?
  set -e
  return "$rc"
}

# Joins the running review and resolves its run dir. Sets REVIEW_RUN and
# FINDINGS_JSON. Starts the review first if none is running (the CI-fix path
# discards a review it had to invalidate).
finish_review() {
  local round="$1" rc=0 log new_runs
  [ -n "$REVIEW_PID" ] || start_review "$round"
  STEP_LABEL="Review round $round"
  log="$LOG_DIR/review-$REVIEW_ROUND.log"
  wait_with_status "$REVIEW_PID" "$REVIEW_STARTED" || rc=$?
  REVIEW_PID=""
  [ "$rc" -eq 0 ] || die "pr-codex-review failed (exit $rc), see $log"
  [ "$VERBOSE" -eq 0 ] || cat "$log"

  # The run dir this review created is the one added since the snapshot; a
  # concurrent manual review would make this ambiguous, hence the fallback
  # (the head_sha check in the loop catches a wrong pick).
  new_runs="$(comm -13 <(printf '%s\n' "$RUNS_BEFORE") <(list_review_runs) | grep . || true)"
  if [ "$(printf '%s\n' "$new_runs" | grep -c .)" -eq 1 ]; then
    REVIEW_RUN="$new_runs"
  else
    echo "warning: could not identify exactly one new pr-codex-review run dir; falling back to the newest" >&2
    # shellcheck disable=SC2012  # mtime ordering wanted; run dir names contain no newlines
    REVIEW_RUN="$(ls -td "$HOME/.cache/pr-codex-review/$SAFE_REPO-pr-$PR_NUMBER-"* 2>/dev/null | head -1)"
  fi
  FINDINGS_JSON="$REVIEW_RUN/output/findings.json"
  [ -f "$FINDINGS_JSON" ] || die "no findings.json in $REVIEW_RUN (pr-codex-review >= 1.2.0 required)"
}

# A CI fix changes the head sha, so a review of the current head is about to
# become stale. Wait it out rather than killing it: pr-codex-review starts its
# own Codex children, and a half-torn-down process tree is not worth the risk.
# For abort paths that drop the EXIT trap (they send their own notification)
# and therefore never reach cleanup.
kill_review() {
  [ -z "$REVIEW_PID" ] || kill_tree "$REVIEW_PID" 2>/dev/null || true
  REVIEW_PID=""
}

discard_review() {
  [ -n "$REVIEW_PID" ] || return 0
  echo "${C_DIM}CI needs a fix; discarding the review of the outgoing head...${C_RESET}"
  STEP_LABEL="Review round $REVIEW_ROUND (discarded)"
  wait_with_status "$REVIEW_PID" "$REVIEW_STARTED" || true
  REVIEW_PID=""
  mv "$LOG_DIR/review-$REVIEW_ROUND.log" "$LOG_DIR/review-$REVIEW_ROUND-discarded.log" 2>/dev/null || true
}

# --- CI ---------------------------------------------------------------------------

# Prints pass|none|fail. Retries while GitHub has not registered checks yet.
ci_status() {
  local waited=0 rc out
  while :; do
    set +e
    out="$(gh pr checks "$PR_NUMBER" --watch --fail-fast 2>&1)"
    rc=$?
    set -e
    printf '%s\n' "$out" | tail -n 20 > "$LOG_DIR/ci-last.log"
    if [ "$rc" -eq 0 ]; then
      echo pass
      return 0
    fi
    if printf '%s' "$out" | grep -qi 'no checks reported'; then
      if [ "$waited" -ge 180 ]; then
        echo none
        return 0
      fi
      sleep 20
      waited=$((waited + 20))
      continue
    fi
    if [ "$rc" -eq 8 ]; then
      sleep 10
      continue
    fi
    echo fail
    return 0
  done
}

ensure_ci_green() {
  local attempt=0 status fails pre_sha
  while :; do
    echo "${C_DIM}waiting for CI on PR #$PR_NUMBER...${C_RESET}"
    status="$(ci_status)"
    case "$status" in
      pass)
        echo "${C_GREEN}CI green.${C_RESET}"
        return 0
        ;;
      none)
        echo "warning: no CI checks reported on this PR; continuing." >&2
        return 0
        ;;
      fail)
        attempt=$((attempt + 1))
        if [ "$attempt" -gt "$MAX_CI_FIXES" ]; then
          return 1
        fi
        echo "${C_RED}CI red; starting fix attempt $attempt/$MAX_CI_FIXES.${C_RESET}"
        discard_review
        fails="$(gh pr checks "$PR_NUMBER" --json name,bucket,workflow,link,description 2>/dev/null | jq '[.[] | select(.bucket == "fail" or .bucket == "cancel")]')"
        pre_sha="$(git -C "$WORKTREE" rev-parse HEAD)"
        codex_call "ci-fix-$attempt" "CI on PR #$PR_NUMBER is red. Failing checks as JSON:

$fails

Inspect the failures with gh (for example: gh run view <run-id> --log-failed; the run id is the number after /runs/ in the link). Reproduce locally where practical, fix the problems, run the affected checks locally, commit, and push. Do not wait for CI; the pipeline watches the checks for you and starts another fix session if they are still red."
        question_gate "ci-fix-$attempt"
        ensure_committed "ci-fix-$attempt"
        CI_FIX_TOTAL=$((CI_FIX_TOTAL + 1))
        record_round "CI fix $CI_FIX_TOTAL" "$pre_sha"
        push_branch
        ;;
    esac
  done
}

# --- Main loop ----------------------------------------------------------------------

step "CI"
# The first review only needs the pushed PR head, so it can already run while
# the initial CI wait happens.
start_review 1
if ! ensure_ci_green; then
  kill_review
  notify "CI rot" "PR #$PR_NUMBER nach $MAX_CI_FIXES Fix-Versuchen weiter rot"
  echo "CI still red after $MAX_CI_FIXES fix attempts: $PR_URL" >&2
  trap - EXIT
  exit 3
fi

CONVERGED=0
ITERATION=0

while [ "$ITERATION" -lt "$MAX_ITER" ]; do
  ITERATION=$((ITERATION + 1))
  step "Review round $ITERATION/$MAX_ITER"
  finish_review "$ITERATION"
  REVIEWED_SHA="$(jq -r '.head_sha' "$FINDINGS_JSON")"
  CURRENT_SHA="$(git -C "$WORKTREE" rev-parse HEAD)"
  [ "$REVIEWED_SHA" = "$CURRENT_SHA" ] || die "findings.json is for $REVIEWED_SHA but the branch is at $CURRENT_SHA"

  BLOCKERS="$(jq -r '.blockers' "$FINDINGS_JSON")"
  CRITICAL="$(jq -r '.critical' "$FINDINGS_JSON")"
  FINDINGS_LINE="$BLOCKERS blockers, $CRITICAL critical, $(jq -r '.suggestions' "$FINDINGS_JSON") suggestions, $(jq -r '.questions' "$FINDINGS_JSON") questions"
  if [ "$((BLOCKERS + CRITICAL))" -eq 0 ]; then
    echo "${C_DIM}$SYM_OK Review round $ITERATION · $(format_duration "$(( $(date +%s) - REVIEW_STARTED ))") ·${C_RESET} ${C_GREEN}$FINDINGS_LINE${C_RESET}"
    CONVERGED=1
    break
  fi
  echo "${C_DIM}$SYM_OK Review round $ITERATION · $(format_duration "$(( $(date +%s) - REVIEW_STARTED ))") ·${C_RESET} ${C_RED}$FINDINGS_LINE${C_RESET}"

  step "Fix round $ITERATION/$MAX_ITER"
  PRE_FIX_SHA="$CURRENT_SHA"
  codex_call "fix-round-$ITERATION" "An external code review of PR #$PR_NUMBER found issues. The full review comment follows below.

Please check for each finding whether it is a real issue or might be intended behavior.
- For every real issue that is not intended: plan and fix it. This is mandatory for Blockers and Critical findings.
- Suggestions: implement each one unless it describes intended behavior or you have a strong technical reason not to.
- Resolve the Questions with your best judgment; only raise OPEN QUESTIONS if one truly needs a product decision.
- Run the affected checks, commit your work, and push. Do not wait for CI; the pipeline watches the checks for you.

Unless you end with the DISPUTED FINDINGS marker, end your final message with a line that is exactly:
PR COMMENT:
followed by a short log comment for the PR: what you fixed and how, and which findings you left unchanged because they are intended. Write it in the language of the PR description, plain and factual, and never mention AI, agents, or automation in it. Use this marker for nothing else.

---

$(cat "$REVIEW_RUN/output/final-pr-comment.md")"
  question_gate "fix-round-$ITERATION"
  ensure_committed "fix-round-$ITERATION"

  if [ "$(git -C "$WORKTREE" rev-parse HEAD)" = "$PRE_FIX_SHA" ]; then
    if grep -q '^DISPUTED FINDINGS:' "$LAST_MSG"; then
      dispute_gate "fix-round-$ITERATION" "$PRE_FIX_SHA"
      if [ "$DISPUTE_ACCEPTED" -eq 1 ]; then
        CONVERGED=1
        break
      fi
      # dispute_gate only returns unaccepted when new commits exist.
    else
      notify "Festgefahren" "Fix-Runde $ITERATION hat nichts geaendert"
      echo "Fix round $ITERATION produced no commits although findings remain; a human is needed: $PR_URL" >&2
      trap - EXIT
      exit 5
    fi
  fi

  record_round "Review fix round $ITERATION" "$PRE_FIX_SHA"
  push_branch
  post_fix_comment "$ITERATION" "$PRE_FIX_SHA"
  # Overlap the next review with this round's CI wait.
  [ "$ITERATION" -ge "$MAX_ITER" ] || start_review "$((ITERATION + 1))"
  if ! ensure_ci_green; then
    kill_review
    notify "CI rot" "PR #$PR_NUMBER nach Fix-Runde $ITERATION weiter rot"
    echo "CI still red after review fix round $ITERATION: $PR_URL" >&2
    trap - EXIT
    exit 3
  fi
done

# --- Summary -------------------------------------------------------------------------

echo
hr
row "PR" "${C_BOLD}#$PR_NUMBER${C_RESET} $PR_URL"
row "Branch" "$BRANCH"
row "Rounds" "$ITERATION review round(s)"
row "Duration" "$(format_duration "$(( $(date +%s) - SCRIPT_STARTED ))")"
if [ -n "$ROUND_LOG" ]; then
  echo "  Commits per round:"
  printf '%s' "$ROUND_LOG" | sed 's/^\(.\)/    \1/'
fi
if [ "$CONVERGED" -eq 1 ]; then
  if [ "$DISPUTE_ACCEPTED" -eq 1 ]; then
    if [ "$INTERACTIVE" -eq 1 ]; then
      row "Result" "${C_GREEN}CI green; remaining findings disputed by Codex, accepted by you${C_RESET}"
    else
      row "Result" "${C_GREEN}CI green; remaining findings disputed by Codex, auto-accepted after the forced re-check${C_RESET}"
    fi
    echo "  Note: the review comment on the PR still lists the disputed findings."
    if [ -n "$DISPUTE_TEXT" ]; then
      printf '%s\n' "$DISPUTE_TEXT" | sed 's/^/  /'
    fi
    hr
    notify "Fertig" "PR #$PR_NUMBER fertig; Disputes akzeptiert, bereit fuer den manuellen Test"
  else
    row "Result" "${C_GREEN}review clean, CI green${C_RESET}"
    hr
    notify "Fertig" "PR #$PR_NUMBER ist bereit fuer den manuellen Test"
  fi
  exit 0
fi
row "Result" "${C_RED}not converged after $MAX_ITER review rounds${C_RESET}"
hr
notify "Nicht konvergiert" "PR #$PR_NUMBER hat nach $MAX_ITER Runden weiter Findings"
trap - EXIT
exit 4
